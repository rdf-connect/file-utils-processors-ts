@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix rdfcp: <https://w3id.org/rdf-connect/processors#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.

rdfcp:GlobRead a owl:Class, rdfs:Class;
  rdfs:label "Glob Read";
  rdfs:comment "Reads all files according to the Glob pattern";
  rdfc:jsImplementationOf rdfc:Processor;
  rdfc:file <./lib/FileUtils.js>;
  rdfc:class "GlobRead";
  rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:GlobRead;
  sh:property [
    sh:path rdfcp:glob;
    sh:codeIdentifier "globPattern";
    sh:name "Glob pattern";
    sh:description "Glob pattern that selects the files to read.";
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:output;
    sh:codeIdentifier "writer";
    sh:name "Output channel";
    sh:description "Output channel to which the content of every matched file is written.";
    sh:class rdfc:Writer;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:wait;
    sh:codeIdentifier "wait";
    sh:name "Wait time";
    sh:description "Time in milliseconds to wait after sending each file; default is 0.";
    sh:datatype xsd:integer;
    sh:defaultValue 0;
    sh:maxCount 1;
  ], [
    sh:path rdfcp:closeOnEnd;
    sh:codeIdentifier "closeOnEnd";
    sh:name "Close on end";
    sh:description "Close the output channel after all files are sent; default is true.";
    sh:datatype xsd:boolean;
    sh:defaultValue true;
    sh:maxCount 1;
  ].

rdfcp:FolderRead a owl:Class, rdfs:Class;
  rdfc:jsImplementationOf rdfc:Processor;
  rdfs:label "Folder Read";
  rdfs:comment "Reads all files inside the folder";
  rdfc:file <./lib/FileUtils.js>;
  rdfc:class "ReadFolder";
  rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:FolderRead;
  sh:property [
    sh:path rdfcp:folderPath;
    sh:codeIdentifier "folder";
    sh:name "Folder";
    sh:description "Path to the folder whose files, including those in subfolders, are read.";
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:output;
    sh:codeIdentifier "writer";
    sh:name "Output channel";
    sh:description "Output channel to which the content of every file is written.";
    sh:class rdfc:Writer;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:maxMemory;
    sh:codeIdentifier "maxMemory";
    sh:name "Maximum memory";
    sh:description "Heap usage in GB above which the processor pauses before reading the next file; default is 3.";
    sh:datatype xsd:double;
    sh:defaultValue 3.0;
    sh:maxCount 1;
  ], [
    sh:path rdfcp:pause;
    sh:codeIdentifier "pause";
    sh:name "Pause";
    sh:description "Time in milliseconds to pause when the memory limit is exceeded; default is 5000.";
    sh:datatype xsd:integer;
    sh:defaultValue 5000;
    sh:maxCount 1;
  ].

rdfcp:Substitute a owl:Class, rdfs:Class;
  rdfc:jsImplementationOf rdfc:Processor;
  rdfs:label "String substitute processor";
  rdfs:comment "Simple string manipulation processor. Transform a stream by applying the string substitution on the messages. The matching string can be a regex.";
  rdfc:file <./lib/FileUtils.js>;
  rdfc:class "Substitute";
  rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:Substitute;
  sh:property [
    sh:path rdfcp:input;
    sh:codeIdentifier "reader";
    sh:name "Input channel";
    sh:description "Input channel with the text messages to transform.";
    sh:class rdfc:Reader;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:output;
    sh:codeIdentifier "writer";
    sh:name "Output channel";
    sh:description "Output channel to which the transformed messages are written.";
    sh:class rdfc:Writer;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:source;
    sh:codeIdentifier "source";
    sh:name "Search string";
    sh:description "String, or regular expression if regexp is true, to search for in every message.";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:replace;
    sh:codeIdentifier "replace";
    sh:name "Replacement";
    sh:description "String that replaces every match.";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:regexp;
    sh:codeIdentifier "regexp";
    sh:name "Regular expression";
    sh:description "Interpret the search string as a regular expression; default is false.";
    sh:datatype xsd:boolean;
    sh:defaultValue false;
    sh:maxCount 1;
  ].

rdfcp:Envsub a owl:Class, rdfs:Class;
  rdfc:jsImplementationOf rdfc:Processor;
  rdfs:label "Environment substitute processor";
  rdfs:comment "Substitutes all declared environment variables to their respective values.";
  rdfc:file <./lib/FileUtils.js>;
  rdfc:class "Envsub";
  rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:Envsub;
  sh:property [
    sh:path rdfcp:input;
    sh:codeIdentifier "reader";
    sh:name "Input channel";
    sh:description "Input channel with the text messages in which to substitute environment variables.";
    sh:class rdfc:Reader;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:output;
    sh:codeIdentifier "writer";
    sh:name "Output channel";
    sh:description "Output channel to which the messages are written, with every ${NAME} replaced by the value of the environment variable NAME.";
    sh:class rdfc:Writer;
    sh:maxCount 1;
    sh:minCount 1;
  ].

rdfcp:ReadFile a owl:Class, rdfs:Class;
  rdfc:jsImplementationOf rdfc:Processor;
  rdfs:label "On demand file reader processor";
  rdfs:comment "Reads a requested file on demand.";
  rdfc:file <./lib/FileUtils.js>;
  rdfc:class "GetFileFromFolder";
  rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:ReadFile;
  sh:property [
    sh:path rdfcp:input;
    sh:codeIdentifier "reader";
    sh:name "Input channel";
    sh:description "Input channel with the names of the files to read, relative to the folder path.";
    sh:class rdfc:Reader;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:folderPath;
    sh:codeIdentifier "folderPath";
    sh:name "Folder path";
    sh:description "Path to the folder that contains the files to read.";
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:output;
    sh:codeIdentifier "writer";
    sh:name "Output channel";
    sh:description "Output channel to which the content of every requested file is written.";
    sh:class rdfc:Writer;
    sh:maxCount 1;
    sh:minCount 1;
  ].

rdfcp:UnzipFile a owl:Class, rdfs:Class;
  rdfc:jsImplementationOf rdfc:Processor;
  rdfs:label "Unzip processor";
  rdfs:comment "Processor to unzip a compressed file and stream out its content.";
  rdfc:file <./lib/FileUtils.js>;
  rdfc:class "UnzipFile";
  rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:UnzipFile;
  sh:property [
    sh:path rdfcp:input;
    sh:codeIdentifier "reader";
    sh:name "Input channel";
    sh:description "Input channel with the ZIP archives to extract.";
    sh:class rdfc:Reader;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:output;
    sh:codeIdentifier "writer";
    sh:name "Output channel";
    sh:description "Output channel to which the content of every file in the archives is written.";
    sh:class rdfc:Writer;
    sh:maxCount 1;
    sh:minCount 1;
  ].

rdfcp:GunzipFile a owl:Class, rdfs:Class;
  rdfc:jsImplementationOf rdfc:Processor;
  rdfs:label "Gunzip processor";
  rdfs:comment "Processor to gunzip a compressed file and stream out its content.";
  rdfc:file <./lib/FileUtils.js>;
  rdfc:class "GunzipFile";
  rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:GunzipFile;
  sh:property [
    sh:path rdfcp:input;
    sh:codeIdentifier "reader";
    sh:name "Input channel";
    sh:description "Input channel with the gzip-compressed data to decompress.";
    sh:class rdfc:Reader;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:output;
    sh:codeIdentifier "writer";
    sh:name "Output channel";
    sh:description "Output channel to which the decompressed data is written.";
    sh:class rdfc:Writer;
    sh:maxCount 1;
    sh:minCount 1;
  ].

rdfcp:FileWriter a owl:Class, rdfs:Class;
  rdfc:jsImplementationOf rdfc:Processor;
  rdfs:label "JavaScript file writer processor";
  rdfs:comment "Writes incoming data to a file.";
  rdfc:file <./lib/FileUtils.js>;
  rdfc:class "FileWriter";
  rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:FileWriter;
  sh:property [
    sh:path rdfcp:filePath;
    sh:codeIdentifier "filePath";
    sh:name "File path";
    sh:description "Path to the file to write the incoming data to.";
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:input;
    sh:codeIdentifier "input";
    sh:name "Input channel";
    sh:description "Input channel with the data to write to the file.";
    sh:class rdfc:Reader;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:readAsStream;
    sh:codeIdentifier "readAsStream";
    sh:name "Read as stream";
    sh:description "Read the incoming data as streams instead of whole messages; default is false.";
    sh:datatype xsd:boolean;
    sh:defaultValue false;
    sh:maxCount 1;
  ], [
    sh:path rdfcp:binary;
    sh:codeIdentifier "binary";
    sh:name "Binary";
    sh:description "Write the incoming messages as bytes instead of text; ignored when reading as stream; default is false.";
    sh:datatype xsd:boolean;
    sh:defaultValue false;
    sh:maxCount 1;
  ].